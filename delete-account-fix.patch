From 2392ab704dc08c21420a4a6512a9662a77802978 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 00:00:07 +0000
Subject: [PATCH] Delete account: explicit auth token, show real error detail;
 hide Google sign-in unless enabled

---
 .env.example                |  2 ++
 app/delete-account/page.tsx | 26 ++++++++++++++++++++++----
 lib/deletionErrors.ts       | 21 +++++++++++++++++++++
 3 files changed, 45 insertions(+), 4 deletions(-)

diff --git a/.env.example b/.env.example
index 00b604d..d886447 100644
--- a/.env.example
+++ b/.env.example
@@ -4,3 +4,5 @@ NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
 # Optional: public contact address shown on legal pages
 NEXT_PUBLIC_SUPPORT_EMAIL=""
 # NEVER add a service-role key here. It lives only in Supabase Edge Function secrets.
+# Set to "true" only after the Google provider and this site's /delete-account URL are allowed in Supabase Auth.
+NEXT_PUBLIC_ENABLE_GOOGLE_SIGNIN="false"
diff --git a/app/delete-account/page.tsx b/app/delete-account/page.tsx
index 2b3844b..b6a1b33 100644
--- a/app/delete-account/page.tsx
+++ b/app/delete-account/page.tsx
@@ -8,7 +8,10 @@ import { PublicFooter } from '@/components/layout/PublicFooter';
 import { PageBanner } from '@/components/layout/PageBanner';
 import { supabase } from '@/services/supabase';
 import { SUPPORT_EMAIL } from '@/lib/contact';
-import { deletionFailureMessage } from '@/lib/deletionErrors';
+import { deletionFailureMessage, deletionErrorDetail } from '@/lib/deletionErrors';
+
+// Google sign-in is hidden unless explicitly enabled (needs Google provider + redirect URL set in Supabase).
+const GOOGLE_ENABLED = process.env.NEXT_PUBLIC_ENABLE_GOOGLE_SIGNIN === 'true';
 
 type Phase = 'signin' | 'confirm' | 'working' | 'done';
 
@@ -39,10 +42,25 @@ export default function DeleteAccountPage() {
   };
   const del = async () => {
     setErr(''); setPhase('working');
-    const { data, error } = await supabase!.functions.invoke('delete-account', { body: { confirm: true } });
+    // Make sure we send a fresh, valid access token explicitly.
+    let token: string | undefined;
+    try {
+      const { data: refreshed } = await supabase!.auth.refreshSession();
+      token = refreshed.session?.access_token;
+      if (!token) token = (await supabase!.auth.getSession()).data.session?.access_token;
+    } catch { /* fall through; invoke will report */ }
+    if (!token) {
+      setPhase('signin'); setErr('Your session expired. Please sign in again.');
+      return;
+    }
+    const { data, error } = await supabase!.functions.invoke('delete-account', {
+      body: { confirm: true },
+      headers: { Authorization: `Bearer ${token}` },
+    });
     if (error || !data?.success) {
       setPhase('confirm');
-      setErr(deletionFailureMessage(error));
+      const detail = error ? await deletionErrorDetail(error) : (data?.error ? String(data.error) : 'Function returned success=false');
+      setErr(deletionFailureMessage(error) + (detail ? ` [${detail}]` : ''));
       return;
     }
     await supabase!.auth.signOut();
@@ -73,7 +91,7 @@ export default function DeleteAccountPage() {
               <label className="block space-y-1"><span className="text-xs font-bold uppercase">Password</span><input className={input} type="password" required autoComplete="current-password" value={password} onChange={(e) => setPassword(e.target.value)} /></label>
               <button disabled={busy} className="w-full py-3 rounded-xl bg-slate-900 text-white font-bold disabled:opacity-60">{busy ? 'Signing in…' : 'Sign in to continue'}</button>
             </form>
-            <button onClick={google} className="w-full py-3 rounded-xl border border-slate-300 dark:border-slate-700 font-bold">Continue with Google</button>
+            {GOOGLE_ENABLED && <button onClick={google} className="w-full py-3 rounded-xl border border-slate-300 dark:border-slate-700 font-bold">Continue with Google</button>}
             <p className="text-xs text-slate-500">Can&apos;t sign in? Email {SUPPORT_EMAIL} and we will help verify ownership. See the <Link href="/privacy-policy" className="underline">Privacy Policy</Link> for what is deleted and what is retained.</p>
           </div>
         )}
diff --git a/lib/deletionErrors.ts b/lib/deletionErrors.ts
index 01b3af3..0058c88 100644
--- a/lib/deletionErrors.ts
+++ b/lib/deletionErrors.ts
@@ -12,3 +12,24 @@ export function deletionFailureMessage(error: unknown): string {
   const status = (error as { context?: { status?: unknown } } | null | undefined)?.context?.status;
   return status === 401 ? SESSION_GONE_MESSAGE : DELETION_INCOMPLETE_MESSAGE;
 }
+
+// Reads the real reason out of a supabase-js FunctionsHttpError / FunctionsFetchError so the page can show it.
+// Never throws. Returns e.g. "HTTP 404: Function not found" or "Network/CORS error: Failed to send a request...".
+export async function deletionErrorDetail(error: unknown): Promise<string> {
+  try {
+    const e = error as { name?: string; message?: string; context?: unknown } | null | undefined;
+    if (!e) return '';
+    const ctx = e.context as { status?: number; clone?: () => { text: () => Promise<string> }; text?: () => Promise<string> } | undefined;
+    if (ctx && typeof ctx.status === 'number') {
+      let body = '';
+      try { body = await (ctx.clone ? ctx.clone().text() : ctx.text!()); } catch { /* ignore */ }
+      let msg = body;
+      try { const j = JSON.parse(body); msg = j.error || j.message || j.msg || body; } catch { /* plain text */ }
+      return `HTTP ${ctx.status}${msg ? `: ${String(msg).slice(0, 200)}` : ''}`;
+    }
+    if (e.name === 'FunctionsFetchError') return `Network/CORS error: ${e.message ?? 'request could not be sent'}`;
+    return e.message ? String(e.message).slice(0, 200) : '';
+  } catch {
+    return '';
+  }
+}
-- 
